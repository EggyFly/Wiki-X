# Wiki-X config example

# 配置优先级 | 进程环境变量 > 配置文件同目录的 .env > YAML
# Config priority | Process env > .env next to the config file > YAML

# 提示 | 请先复制为 .env 后修改
# Note | Copy to .env before editing

# 提示 | 站点导航/i18n(多语言)等结构性配置在 YAML 里
# Note | Site nav and i18n stay in YAML

# 提示 | 数据库容器口令和宿主机端口仅 Docker Compose 使用
# Note | Database container password and host port are only for Docker Compose

# 上线前必须改, 要和 DATABASE_URL 里的口令一致
# Must change before production and match the password in DATABASE_URL
POSTGRES_PASSWORD="wiki_x-change-me"

# 宿主机映射端口
# Host port mapping
PORT=8080


#########################
# 站点 / Site
#########################

# 站点名
# Site title
SITE_TITLE="Wiki-X"

# 站点描述
# Site description
SITE_DESCRIPTION=""

# 站点 base URL; 邮件链接和 canonical 依赖它, 不要以 / 结尾
# Site base URL; used by email links and canonical, no trailing slash
SITE_BASE_URL="http://localhost:8080"

# 站点首选语言
# Default UI language
SITE_LANGUAGE="zh-CN"

# 在内容页显示搜索/编辑入口
# Show search/edit entries on content pages
SITE_COMMUNITY_UI=true

#########################


#########################
# 数据源 / Content source
#########################

# 内容来源. 填入 postgres 或 git. postgres 使用 PostgreSQL 作为数据源, git 使用仓库内容
# Content source. Use postgres or git. postgres stores content in PostgreSQL; git reads from the repository
CONTENT_SOURCE=postgres

# Git 模式的内容目录; git 模式和 import 都会读这里
# Git content directory; used by git mode and import
CONTENT_DIR="content"

# Git 仓库地址, 支持 https://, ssh://, git://, git@host:owner/repo.git. 留空只使用本地目录, import 时也会自动克隆
# Git repository URL; supports https://, ssh://, git://, git@host:owner/repo.git. Empty means local directory only; import also clones
CONTENT_GIT_URL=""

# 克隆时使用的分支, 留空使用远端默认分支
# Branch used for clone; empty uses the remote default
CONTENT_GIT_BRANCH="main"

# 0 为完整克隆, 大于 0 为浅克隆深度
# 0 means full clone; positive values set shallow depth
CONTENT_GIT_DEPTH=0

# 单篇 Markdown 最大字节数
# Max bytes per Markdown file
CONTENT_MAX_FILE_SIZE=1048576

# 定时重载间隔, 0s 关闭
# Auto reload interval; 0s disables
CONTENT_RELOAD_INTERVAL="0s"

# 配置 git_url 后, 已存在的仓库在启动和 push webhook 时执行 git pull --ff-only
# With git_url set, existing repos run git pull --ff-only on startup and push webhook
CONTENT_GIT_PULL=false

#########################


#########################
# HTTP 服务 / server
#########################

# HTTP 服务监听地址, :8080 表示监听所有网卡的 8080 端口
# HTTP listen address; :8080 listens on all interfaces
SERVER_ADDR=":8080"

# 访问日志: true 记录所有请求; false 只记录 5xx; /-/healthz 不记录
# Access log: true logs all requests; false logs only 5xx; /-/healthz is never logged
SERVER_ACCESS_LOG=false

#########################


#########################
# 主题与皮肤 / Themes&skins
#########################

# 默认皮肤: default/compact/外部主题名
# Default skin: default/compact/external theme name
THEME_DEFAULT="default"

# 是否禁止用户切换皮肤
# Disable user skin switching
THEME_DISABLE_SWITCH=false

# 外部主题目录, 留空使用内置主题
# External theme directory; empty uses built-in themes
THEME_DIR=""

# 主题根目录, 下面的每个子目录会被加载为一个皮肤
# Theme root; each subdirectory is loaded as a skin
THEME_ROOT=""

#########################


#########################
# 数据库 / Database
#########################

# 本地示例 / LOCAL EXAMPLE: postgres://postgres:password@127.0.0.1:5432/wiki_x_dev?sslmode=disable
# Compose 示例 / COMPOSE EXAMPLE: postgres://wiki_x:wiki_x-change-me@db:5432/wiki_x?sslmode=disable
# postgres 模式必填; git 模式下配置后才有账号/审核/后台
# Required for postgres; in git mode it enables accounts/review/admin
DATABASE_URL=""

# 连接池最大连接数
# Max connections
DATABASE_MAX_CONNS=10

# 启动时自动执行内嵌迁移
# Run embedded migrations on startup
DATABASE_AUTO_MIGRATE=true

#########################


#########################
# 缓存 / Cache
#########################
# auto: 有 Redis 用 Redis 否则内存; memory: 仅内存; redis: 必须连上
# auto: use Redis if available, otherwise memory; memory: memory only; redis: must connect
CACHE_DRIVER=auto

# 缓存默认过期时间
# Default cache TTL
CACHE_TTL="10m"

# 内存缓存最大条目数
# Max memory cache entries
CACHE_MAX_ENTRIES=2000

# 内存缓存最大字节数
# Max memory cache bytes
CACHE_MAX_BYTES=67108864

# Redis 地址
# Redis address
REDIS_ADDR="127.0.0.1:6379"

# Redis 密码
# Redis password
REDIS_PASSWORD=""

# Redis 库号
# Redis database number
REDIS_DB=0

# 同一 Redis 上多站点必须使用不同前缀
# Different sites on the same Redis must use different prefixes
REDIS_PREFIX="wiki_x"

#########################


#########################
# 安全 / Security
#########################

# HTTPS 部署必须开启
# Required when deployed over HTTPS
AUTH_SECURE_COOKIES=false

# 会话有效期
# Session TTL
AUTH_SESSION_TTL="336h"

# 反代 CIDR 列表, 逗号分隔; 配置后才信任 X-Forwarded-For
# Trusted proxy CIDRs, comma-separated; X-Forwarded-For is trusted only when set
AUTH_TRUSTED_PROXIES=""

#########################


#########################
# 上传 / Uploads
#########################

# 上传文件目录
# Upload directory
MEDIA_DIR="data/media"

# 单个上传文件最大字节数
# Max bytes per uploaded file
MEDIA_MAX_SIZE=8388608

#########################


#########################
# SMTP
#########################

# host 和 from 同时填写才启用邮箱验证/密码找回, 需要 site.base_url
# Set both host and from to enable email verification/password reset; requires site.base_url
MAIL_HOST=""

# 邮件端口, 465 时通常配合 IMPLICIT_TLS
# Mail port; 465 usually uses IMPLICIT_TLS
MAIL_PORT=587

# SMTP 用户名
# SMTP username
MAIL_USERNAME=""

# SMTP 密码
# SMTP password
MAIL_PASSWORD=""

# 发件人地址
# Sender address
MAIL_FROM=""

# 465 端口直连 TLS 时设为 true
# Set true for direct TLS on port 465
MAIL_IMPLICIT_TLS=false

#########################


#########################
# 注册 / Registration
#########################

# off: 关闭, invite: 邀请码, open: 开放注册(必须配置邮件)
# off: disabled, invite: invite code, open: open registration (mail required)
REGISTRATION_MODE=off

# 新用户默认组
# Default group for new users
REGISTRATION_DEFAULT_GROUP="user"

#########################


#########################
# 审计 / Audit
#########################

# 0s 关闭; 开启时不得少于 180 天
# 0s disables; enabled retention must be at least 180 days
AUDIT_RETENTION="0s"

# 审计归档目录
# Audit archive directory
AUDIT_ARCHIVE_DIR="data/audit"

# 审计归档间隔
# Audit archive interval
AUDIT_INTERVAL="24h"

#########################


#########################
# 限流 / Rate limit
#########################

# 评论限流次数
# Comment rate limit count
COMMENT_RATE_LIMIT=5

# 评论限流窗口
# Comment rate limit window
COMMENT_RATE_WINDOW=1m

# 全局限流开关
# Global rate limit switch
RATE_LIMIT_ENABLED=false

# 全局限流请求数
# Global request limit
RATE_LIMIT_REQUESTS=300

# 全局限流窗口
# Global rate limit window
RATE_LIMIT_WINDOW="1m"

# IP+路径单独限流, 0 关闭
# Per IP+path limit; 0 disables
RATE_LIMIT_ROUTE_REQUESTS=0

# IP+路径限流窗口
# Per IP+path limit window
RATE_LIMIT_ROUTE_WINDOW="1m"

#########################


#########################
# 搜索 / Search
#########################

# auto: PG 内容源用数据库搜索, memory: 内存, postgres: 数据库, meilisearch: 外置
# auto: DB search for PG content source, memory: in-memory, postgres: database, meilisearch: external
SEARCH_BACKEND=auto

# Meilisearch 地址
# Meilisearch URL
SEARCH_URL=""

# Meilisearch API 密钥
# Meilisearch API key
SEARCH_API_KEY=""

# Meilisearch 索引名
# Meilisearch index name

SEARCH_INDEX="wiki_x"

#########################
# 监控指标 / Metrics (Prometheus)
#
# CONTENTS -
#   HTTP 请求, 限流拒绝, 缓存命中, 渲染耗时, 待审修订, 未处理举报
#   HTTP requests, rate-limit rejects, cache hits, render duration, pending revisions, open reports
#########################

# true 开启指标端点; false 关闭
# true enables the metrics endpoint; false disables
METRICS_ENABLED=false

# 指标端点路径, 不能和其他路由冲突
# Metrics endpoint path; must not conflict with an existing route
METRICS_PATH="/-/metrics"

# 非空时要求 Authorization: Bearer <token>; 留空则公开
# If set, requires Authorization: Bearer <token>; empty means public
METRICS_TOKEN=""

#########################


#########################
# 登录OAuth与仓库 / OAuth&Repo
#########################

# GitHub OAuth App 客户端 ID
# GitHub OAuth App client ID
GITHUB_CLIENT_ID=""

# GitHub OAuth App 客户端密钥
# GitHub OAuth App client secret
GITHUB_CLIENT_SECRET=""

# OAuth 回调地址
# OAuth callback URL
GITHUB_REDIRECT_URL=""

# Webhook 签名密钥
# Webhook signing secret
GITHUB_WEBHOOK_SECRET=""

# 仓库, 格式 owner/repo
# Repository, format owner/repo
GITHUB_REPO=""

# PAT 方式
# PAT authentication
GITHUB_TOKEN=""

# GitHub App 方式
# GitHub App authentication
GITHUB_APP_ID=0

# GitHub App 安装 ID
# GitHub App installation ID
GITHUB_INSTALLATION_ID=0

# 私钥 PEM 内容, 与 PRIVATE_KEY_FILE 二选一
# PEM private key content; mutually exclusive with PRIVATE_KEY_FILE
GITHUB_PRIVATE_KEY=""

# 私钥文件路径
# Private key file path
GITHUB_PRIVATE_KEY_FILE=""

# PR 目标分支
# Target branch for PRs
GITHUB_BASE_BRANCH="main"

# 仓库内内容目录, 留空为根目录
# Content directory in repo; empty means root
GITHUB_CONTENT_PATH=""

# PR 导入策略
# PR import mode
GITHUB_PR_IMPORT=pending

# GitHub API 地址, GitHub Enterprise 可改
# GitHub API URL; change for GitHub Enterprise
GITHUB_API_BASE_URL="https://api.github.com"

#########################